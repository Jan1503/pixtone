<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>PixTone</AssemblyName>
    <RootNamespace>PixTone</RootNamespace>
    <Authors>Jan Wrage</Authors>
    <Description>Host-side sender for the verpixeld audio board: s16le 48 kHz stereo to paced PixTone UDP. No UI or FFmpeg dependency.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

</Project>
